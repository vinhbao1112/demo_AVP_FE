#Region "support function"

    ''' <author>
    '''    	<name> Tin Pham </name>
    '''    	<date> 2016-01-12 </date>
    ''' </author>
    ''' <summary>
    ''' check if PVD Target Power Supply is installed
    ''' </summary>
    Public Overridable Function IsPVDDCTargetPowerSupplyInstalled() As Boolean
        Return False
    End Function

    ''' <author>
    '''    	<name> Tin Pham </name>
    '''    	<date> 2016-01-12 </date>
    ''' </author>
    ''' <summary>
    ''' check if DC target power supply is Pulse DC
    ''' </summary>
    Public Overridable Function IsPulseDCTargetPowerSupply(ByVal dcTargetPowerSupplyModel As String) As Boolean
        Return (dcTargetPowerSupplyModel = HConstants.EniRpg50or100 OrElse _
                dcTargetPowerSupplyModel = HConstants.EniRpg50 OrElse _
                dcTargetPowerSupplyModel = HConstants.EniRpg100 OrElse _
                dcTargetPowerSupplyModel = HConstants.AePulseDC)
    End Function

    ''' <author>
    '''    	<name> Tin Pham </name>
    '''    	<date> 2016-01-12 </date>
    ''' </author>
    ''' <summary>
    ''' Load Configuration Data
    ''' </summary>
    Public Function LoadConfigurationData(ByVal mapCofigData As Hashtable) As Boolean
        Dim result As Boolean = True

        Try
            For Each item As DictionaryEntry In mapCofigData
                Dim propertyName As String = item.Key.Replace(".", "_")
                Dim propInfo As System.Reflection.PropertyInfo = Me.GetType().GetProperty(propertyName)

                If (propInfo IsNot Nothing) Then
                    If (propInfo.CanWrite = True) Then
                        If propInfo.PropertyType.Name = "Boolean" Then
                            Dim value As Boolean = IIf(item.Value.ToLower() = "true", True, False)
                            propInfo.SetValue(Me, value, Nothing)

                        ElseIf propInfo.PropertyType.Name = "String" Then
                            propInfo.SetValue(Me, item.Value, Nothing)

                        End If
                    End If
                End If
            Next
        Catch ex As Exception
            Logger.Error(ex.Message)
            result = False
        End Try

        Return result
    End Function

#End Region

End Class
