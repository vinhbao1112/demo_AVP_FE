Public Class HRPVDConfigurationData
    Inherits GeneralConfigurationData

    ''' <author>
    '''    	<name> Tin Pham </name>
    '''    	<date> 2016-01-12 </date>
    ''' </author>
    ''' <summary>
    ''' Get or Set Vat Valve Installed
    ''' </summary>
    Private _vatValveInstalled As Boolean = False
    Public Property Vat_Valve_Installed() As Boolean
        Get
            Return _vatValveInstalled
        End Get
        Set(ByVal value As Boolean)
            _vatValveInstalled = value
        End Set
    End Property
End Class
