<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <log4net>
    <root>
      <level value="ERROR"/>
      <appender-ref ref="AVPLogFileAppender" />
      <appender-ref ref="TerminalServerRobotLogFileAppender" />
      <appender-ref ref="TerminalServerCryoLogFileAppender" />
      <appender-ref ref="TerminalServerChamberLogFileAppender" />
      <appender-ref ref="PMxLogFileAppender" />
    </root>
    <logger name="AVP">
      <level value="ERROR" />
    </logger>
    <logger name="AVP.KepServer">
      <level value="ERROR" />
    </logger>
    <logger name="AVP.Scheduler">
      <level value="ERROR" />
    </logger>
    <logger name="AVP.TerminalServer">
    </logger>
    <logger name="AVP.GUI">
    </logger>
    <logger name="AVP.Core">
    </logger>
    <logger name="AVP.DataManagerment">
    </logger>
    <logger name="AVP.TerminalServer.Robot">
      <level value="ERROR" />
    </logger>
    <logger name="AVP.TerminalServer.Cryo">
      <level value="ERROR" />
    </logger>
    <logger name="AVP.TerminalServer.Chamber">
      <level value="ERROR" />
    </logger>
    <logger name="AVP.PMx">
      <level value="DEBUG" />
    </logger>
    <appender name="AVPLogFileAppender" type="log4net.Appender.RollingFileAppender" >
      <file value="DataFiles\Archived\LogError\AVP.log.txt"/>
      <appendToFile value="false" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <rollingStyle value="Composite"/>
      <datePattern value=".yyyy.MM.dd"/>
      <maxSizeRollBackups value="3"/>
      <maximumFileSize value="10MB"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%-4t] %-5p %C.%M - %m%n" />
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
          <levelMin value="WARN" />
          <acceptOnMatch value="true" />
      </filter>        
    </appender>
    <appender name="TerminalServerRobotLogFileAppender" type="log4net.Appender.RollingFileAppender" >
      <file value="DataFiles\Archived\LogError\AVP.TerminalServer.Robot.log.txt"/>
      <appendToFile value="false" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <rollingStyle value="Composite"/>
      <datePattern value=".yyyy.MM.dd"/>
      <maxSizeRollBackups value="3"/>
      <maximumFileSize value="10MB"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%-4t] %-7p - %m%n" />
      </layout>
      <filter type="log4net.Filter.LoggerMatchFilter">
        <loggerToMatch value="AVP.TerminalServer.Robot" />
        <acceptOnMatch value="true" />
      </filter>
      <filter type="log4net.Filter.DenyAllFilter" />
    </appender>
    <appender name="TerminalServerCryoLogFileAppender" type="log4net.Appender.RollingFileAppender" >
      <file value="DataFiles\Archived\LogError\AVP.TerminalServer.Cryo.log.txt"/>
      <appendToFile value="false" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <rollingStyle value="Composite"/>
      <datePattern value=".yyyy.MM.dd"/>
      <maxSizeRollBackups value="3"/>
      <maximumFileSize value="10MB"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%-4t] %-7p - %m%n" />
      </layout>
      <filter type="log4net.Filter.LoggerMatchFilter">
        <loggerToMatch value="AVP.TerminalServer.Cryo" />
        <acceptOnMatch value="true" />
      </filter>
      <filter type="log4net.Filter.DenyAllFilter" />
    </appender>
    <appender name="TerminalServerChamberLogFileAppender" type="log4net.Appender.RollingFileAppender" >
      <file value="DataFiles\Archived\LogError\AVP.TerminalServer.Chamber.log.txt"/>
      <appendToFile value="false" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <rollingStyle value="Composite"/>
      <datePattern value=".yyyy.MM.dd"/>
      <maxSizeRollBackups value="3"/>
      <maximumFileSize value="10MB"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%-4t] %-7p - %m%n" />
      </layout>
      <filter type="log4net.Filter.LoggerMatchFilter">
        <loggerToMatch value="AVP.TerminalServer.Chamber" />
        <acceptOnMatch value="true" />
      </filter>
      <filter type="log4net.Filter.DenyAllFilter" />
    </appender>
    <appender name="PMxLogFileAppender" type="log4net.Appender.RollingFileAppender" >
      <file value="DataFiles\Archived\LogError\AVP.PMx.log.txt"/>
      <appendToFile value="false" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <rollingStyle value="Composite"/>
      <datePattern value=".yyyy.MM.dd"/>
      <maxSizeRollBackups value="3"/>
      <maximumFileSize value="10MB"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%-4t] %-7p - %m%n" />
      </layout>
      <filter type="log4net.Filter.LoggerMatchFilter">
        <loggerToMatch value="AVP.PMx" />
        <acceptOnMatch value="true" />
      </filter>
      <filter type="log4net.Filter.DenyAllFilter" />
    </appender>    
  </log4net>
</configuration>