<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="NewDataSet" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
	<xs:simpleType name="gasType">
		<xs:restriction base="xs:float">
		  <xs:minInclusive value="0"/>
		  <xs:maxInclusive value="1000"/>
	  </xs:restriction>
	</xs:simpleType>
	<xs:simpleType name = "booleanType">
	  <xs:restriction base="xs:string">
	    <xs:pattern value="True|False|true|false"/>
	  </xs:restriction>
	</xs:simpleType>
	<xs:simpleType name = "biasControlType">
	  <xs:restriction base="xs:string">
	    <xs:pattern value="Power|Voltage"/>
	  </xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="C1Type">
		<xs:restriction base="xs:float">
		  <xs:minInclusive value="0"/>
		  <xs:maxInclusive value="100"/>
	  </xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="C2Type">
		<xs:restriction base="xs:float">
		  <xs:minInclusive value="0"/>
		  <xs:maxInclusive value="100"/>
	  </xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PowerSPType">
		<xs:restriction base="xs:float">
		  <xs:minInclusive value="0"/>
		  <xs:maxInclusive value="50000"/>
	  </xs:restriction>
	</xs:simpleType>
  <xs:element name="Recipe">
    <xs:complexType>
      <xs:sequence>
	    <xs:element name="Version" type="xs:string" minOccurs="0" />
        <xs:element name="StepList" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Step" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="SeqNo" type="xs:integer" minOccurs="1" />
                    <xs:element name="Gases" minOccurs="1" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Gas1" type="gasType" minOccurs="1" />
                          <xs:element name="Gas2" type="gasType" minOccurs="1" />
                          <xs:element name="Gas3" type="gasType" minOccurs="1" />
                          <xs:element name="Gas4" type="gasType" minOccurs="1" />
                          <xs:element name="Gas5" type="gasType" minOccurs="1" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="ProcessControl" minOccurs="1" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ProcessTime" type="xs:float" minOccurs="1" />
                          <xs:element name="RampTime" type="xs:float" minOccurs="1" />
                          <xs:element name="ProcessPressure" type="xs:float" minOccurs="1" />
                          <xs:element name="ProcessStartPressure" type="xs:float" minOccurs="1" />
                          <xs:element name="TargetPower" type="PowerSPType" minOccurs="1" />
                          <xs:element name="TargetC1" type="C1Type" minOccurs="1" />
                          <xs:element name="TargetC2" type="C2Type" minOccurs="1" />
                          <xs:element name="TargetMatchingMode" type="booleanType" minOccurs="1" />
                          <xs:element name="OpenShutter" type="booleanType" minOccurs="1" />
                          <xs:element name="Pulse" type="booleanType" minOccurs="1" />
                          <xs:element name="PulseFrequency" type="xs:float" minOccurs="0" />
                          <xs:element name="PulseWidth" type="xs:float" minOccurs="0" />
                          <xs:element name="ChuckHeight" type="xs:float" minOccurs="1" />
                          <xs:element name="BiasPower" type="PowerSPType" minOccurs="1" />
                          <xs:element name="BiasVoltage" type="xs:float" minOccurs="1" />
                          <xs:element name="BiasC1" type="C1Type" minOccurs="1" />
                          <xs:element name="BiasC2" type="C2Type" minOccurs="1" />
                          <xs:element name="BiasMatchingMode" type="booleanType" minOccurs="1" />
                          <xs:element name="BiasC1C2FromRecipe" type="booleanType" minOccurs="1" />
                          <xs:element name="BiasControl" type="biasControlType" minOccurs="1" />
                          <xs:element name="PowerDown" type="booleanType" minOccurs="1" />
                          <xs:element name="MagnetState" type="booleanType" minOccurs="1" />
                          <xs:element name="MagCurrent" type="xs:float" minOccurs="1" />
                          <xs:element name="MagnetDutyCycle" type="xs:float" minOccurs="1" />
                          <xs:element name="MagFrequency" type="xs:float" minOccurs="1" />
                          <xs:element name="IsStabilize" type="booleanType" minOccurs="1" />
                          <xs:element name="RecipeComments" type="xs:string" minOccurs="1" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
		<xs:element name="Description" type="xs:string" minOccurs="1" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="NewDataSet" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
    <xs:complexType>
      <xs:choice minOccurs="1" maxOccurs="unbounded">
        <xs:element ref="Recipe" />
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>