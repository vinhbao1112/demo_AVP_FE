<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
      
        <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="ConfigurationManager.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <log4net>
    <root>
      <level value="INFO"/>
      <appender-ref ref="CsvFileAppender" />
    </root>
    <logger name="AVPConfigurationManager.ParameterChanges">
      <level value="INFO" />
    </logger>

    <appender name="CsvFileAppender" type="ConfigurationManager.HeaderOnceAppender" >
      <file type="log4net.Util.PatternString">
        <conversionPattern value="ConfigurationManager_Logs\ConfigurationManager.ParameterChanges.Log.csv" />
      </file>
      <appendToFile value="true" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="-1"/>
      <maximumFileSize value="30MB"/>
      <preserveLogFileNameExtension value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="Date&#32;time,Parameter&#32;name,Old&#32;value,New&#32;value&#13;&#10;" />
        <param name="ConversionPattern" value="%date{yyyy-MM-dd HH:mm:ss.fff},%message%newline" />
      </layout>
      <filter type="log4net.Filter.LoggerMatchFilter">
        <loggerToMatch value="AVPConfigurationManager.ParameterChanges" />
        <acceptOnMatch value="true" />
      </filter>
      <filter type="log4net.Filter.DenyAllFilter" />
    </appender>
  </log4net>
    <userSettings>
        <ConfigurationManager.Properties.Settings>
            <setting name="TYPE" serializeAs="String">
                <value>PVD4</value>
            </setting>
            <setting name="AVP_USER_CONFIG" serializeAs="String">
                <value>ConfigFiles\UserConfig\ConfigurationServer.xml</value>
            </setting>
            <setting name="PVD_USER_CONFIG" serializeAs="String">
                <value>Config\PVDConfig.xml</value>
            </setting>
            <setting name="PVD_CALFACT_CONFIG" serializeAs="String">
                <value>Config\CALFACT.xml</value>
            </setting>
            <setting name="IBE_USER_CONFIG" serializeAs="String">
                <value>Config\IBEConfig.xml</value>
            </setting>
            <setting name="AVP_SYSTEM_CONFIG" serializeAs="String">
                <value>ConfigFiles\SystemConfig\public\SystemConfig.xml</value>
            </setting>
            <setting name="RIE_USER_CONFIG" serializeAs="String">
                <value>RIECoreFiles\Config\RIEConfig.xml</value>
            </setting>
            <setting name="PQL_USER_CONFIG" serializeAs="String">
                <value>Config\PQLConfig.xml</value>
            </setting>
            <setting name="CORONA_USER_CONFIG" serializeAs="String">
                <value>Config\PVD4Config.xml</value>
            </setting>
            <setting name="AVP_CX_TYPE" serializeAs="String">
                <value>Install_CX4</value>
            </setting>
            <setting name="AVP_DRIVER_CONFIG" serializeAs="String">
                <value>\ConfigFiles\SystemConfig\private\DriverConfig.xml</value>
            </setting>
	          <setting name="BEAM_USER_CONFIG" serializeAs="String">
                <value>Config\BeamConfig.xml</value>
            </setting>
        </ConfigurationManager.Properties.Settings>
    </userSettings>
</configuration>