# to upgrade and merge product changes into your EPJ file. 

[COMMON EVENTS]
#id=name, description, wellknownname
#Add your equipment definitions here
101=CE1,A sample user defined collection event,
102=CE2,A sample user defined collection event,

200=ProcessStateToSETUP,A sample user defined collection event for the Processing State Machine,
201=ProcessStateToEXECUTING,A sample user defined collection event for the Processing State Machine,
202=ProcessStateToIDLE,A sample user defined collection event for the Processing State Machine,

1001=AVPSystemAlarmSET,AVP SECS GEM Common Alarm SET collection event.,
2001=AVPSystemAlarmCLEAR,AVP SECS GEM Common Alarm CLEAR collection event.,

[ALARMS]
#id=name, description, text, setEventID, clearEventID, alarm code (ALCD), wellknownname
#Add your equipment definitions here
1=AVPSystemAlarm, AVP SECS GEM Common Alarm, AVP SECS GEM Common Alarm,1001,2001,0, 

[COMMON VARIABLES]
#varTypes DV,SV,EC
#valTypes I1, I2, I4, I8, U1, U2, U4, U8, F4, F8, A, Bo, Bi, L, J, W
#id=name, description, units, varType, valType, eventID, private, persistant, min, max, default, wellknownname
#Add your equipment definitions here
101=DV1,Example user defined data variable.,,DV,U4,,0,0,,,U4,
102=DV2,Example user defined data variable.,,DV,U4,,0,0,,,U4,
103=DV3,Example user defined data variable.,,DV,F8,,0,0,,,F8,

201=SV1,Example user defined status variable.,,SV,F8,,0,0,,,F8,
202=SV2,Example user defined status variable.,,SV,A,,0,0,,,A,
203=SV3,Example user defined status variable.,,SV,Bo,,0,0,,,Bo,
204=SV4,Example user defined status variable.,,SV,U4,,0,0,,,U4,
205=SV5,Example user defined status variable.,,SV,U4,,0,0,,,U4,
206=SV6,Example user defined status variable.,,SV,U4,,0,0,,,U4,



