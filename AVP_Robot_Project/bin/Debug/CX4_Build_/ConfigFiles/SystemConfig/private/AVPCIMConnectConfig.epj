#WARNING:  This file will be overwritten if SaveProject() is called or the project
#is saved using the Control Panel.  Any user comments will be lost.

#project file: gettingstarted.epj
[CONFIG]
version=4
datesaved=20020122173423
#logging settings: 0=off, 00010000=Errors, 00020000=Messages, 00040000=Protocol, 00080000=Callbacks, 00000100=Other logs
logging=0
#same as in CIMConnect - File Logging Config window
loggingpath=C:\CIMConnectProjects\Equipment1\Projects
loggingdefaultfilename=logfile
loggingmaxfiles=4
loggingmaxfilesize=1000000
loggingtimeperiod=0
#SECS-II Message output limits (see ICxValue::CopyToNString for more info)
loggingmsglimit=-1
loggingmsgelemlimit=-1
#enable logging to file: 0=off 1=on
filelogging=0


[CONNECTION1]
name=GEM Host 5000
encoder=SECSIICodec.CxSECSIIEncoder
decoder=SECSIICodec.CxSECSIIDecoder
commif=CxSMS.CxSMSObject
#If useregforcommifcfg is NOT zero then the commifcfg string will be read from the registry and not the epj file.
useregforcommifcfg=0
#If forceupdatereg is NOT zero then the registry entry for this connection is updated with the commifcfg string.
forceupdatereg=0
commifcfg=1,HSMS,0.0.0.0,5000,PASSIVE,45000,5000,5000,10000,5000,EQUIPMENT,60000,AUTOS9F1,AUTOS9F9
taskdll=cxemtask.dll

[CONNECTION2]
name=GEM Host 5001
encoder=SECSIICodec.CxSECSIIEncoder
decoder=SECSIICodec.CxSECSIIDecoder
commif=CxSMS.CxSMSObject
#If useregforcommifcfg is NOT zero then the commifcfg string will be read from the registry and not the epj file.
useregforcommifcfg=0
#If forceupdatereg is NOT zero then the registry entry for this connection is updated with the commifcfg string.
forceupdatereg=0
commifcfg=2,HSMS,0.0.0.0,5001,PASSIVE,45000,5000,5000,10000,5000,EQUIPMENT,60000,AUTOS9F1,AUTOS9F9
taskdll=cxemtask.dll

[CONNECTION3]
name=GEM Host 5002
encoder=SECSIICodec.CxSECSIIEncoder
decoder=SECSIICodec.CxSECSIIDecoder
commif=CxSMS.CxSMSObject
#If useregforcommifcfg is NOT zero then the commifcfg string will be read from the registry and not the epj file.
useregforcommifcfg=0
#If forceupdatereg is NOT zero then the registry entry for this connection is updated with the commifcfg string.
forceupdatereg=0
commifcfg=3,HSMS,0.0.0.0,5002,PASSIVE,45000,5000,5000,10000,5000,EQUIPMENT,60000,AUTOS9F1,AUTOS9F9
taskdll=cxemtask.dll

#note that all fields must be filled except wellknownname
#empty fields (i.e. ,,) are allowed in some places

[COMMON EVENTS]
#id=name, description, wellknownname
3=MaterialReceived,Material arrived from a port on the equipment.,MaterialReceived
4=MaterialRemoved,Material was sent from a port on the equipment.,MaterialRemoved
6=OperatorCommandIssued,Machine operator issued a control command.,OperatorCommandIssued
7=PPChange,A process program (recipe) has been created changed or deleted.,PPChange
8=PPSelected,A new process program (recipe) has been accepted. Either the host or machine operator has selected the recipe.,PPSelected
9=ProcessingCompleted,Normal exit of EXECUTING state as part of the Processing State Machine.,ProcessingCompleted
10=ProcessingStarted,Normal exit of EXECUTING state as part of the Processing State Machine.,ProcessingStarted
11=ProcessingStateChange,The state of the Processing State Machine has changed.,ProcessingStateChange
12=ProcessingStopped,A previously requested STOP command has been performed.,ProcessingStopped
16=ECChange,An equipment constant value was changed locally by the operator.,ECChange
18=HostCommandAccepted,A host remote command was accepted.,HostCommandAccepted
19=HostECChange,A host changed an equipment constant(EC) value.,HostECChange
20=HostPPChange,A host changed a Process Program.,HostPPChange
21=PPVerificationFailed,Recipe Verification Failed,PPVerificationFailed
