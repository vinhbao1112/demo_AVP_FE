  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
  <PropertyGroup>
    <PostBuildEvent>rd /S /Q bin_release
mkdir bin_release
copy AVP.exe bin_release\
copy AVPLib.dll bin_release\
copy NetLib.dll bin_release\
copy CustomTabControl.dll bin_release\
copy Interop.OPCAutomation.dll bin_release\
copy Interop.EMSERVICELib.dll bin_release\
copy Interop.VALUELib.dll bin_release\
copy AVPSecsGemLib.dll bin_release\
XCOPY /E /I /Y ..\Debug\ConfigFiles bin_release\ConfigFiles
XCOPY /E /I /Y ..\Debug\DataFiles bin_release\DataFiles
copy log4net.dll bin_release\
copy ..\Debug\Tail.exe bin_release\
copy ..\Debug\AVP.exe.config bin_release\
copy ..\..\..\..\ConfigurationManager\ConfigurationManager\bin\Debug\ConfigurationManager.exe.config bin_release\
copy ..\..\..\..\ConfigurationManager\ConfigurationManager\bin\Release\ConfigurationManager.exe bin_release\
copy ..\..\..\..\ConfigurationManager\ConfigurationManager\bin\Debug\ConfigurationManager.log4net bin_release\
copy ZedGraph.dll bin_release\</PostBuildEvent>
    <PreBuildEvent>del ..\Debug\ConfigFiles\SystemConfig\private\MessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\Generic_MessageName.txt &gt;&gt;..\Debug\ConfigFiles\SystemConfig\private\MessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\IBE_MessageName.txt &gt;&gt; ..\Debug\ConfigFiles\SystemConfig\private\MessageName.xml
del ..\Debug\ConfigFiles\SystemConfig\private\ParseMessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\Generic_ParseMessageName.txt&gt;&gt;..\Debug\ConfigFiles\SystemConfig\private\ParseMessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\IBE_ParseMessageName.txt &gt;&gt; ..\Debug\ConfigFiles\SystemConfig\private\ParseMessageName.xml
..\Debug\ConvertXML2VB.exe ..\Debug\ConfigFiles\UserConfig\ ..\Debug\ConfigFiles\UserConfig\
..\Debug\ConvertXML2VB.exe ..\Debug\ConfigFiles\SystemConfig\private\ ..\Debug\ConfigFiles\SystemConfig\private\
..\Debug\ConvertXML2VB.exe ..\Debug\ConfigFiles\SystemConfig\public\ ..\Debug\ConfigFiles\SystemConfig\public\
XCOPY /E /I /Y ..\Debug\ConfigFiles\UserConfig\*.vb "..\..\..\AVP Lib\XMLResource\"
XCOPY /E /I /Y ..\Debug\ConfigFiles\SystemConfig\public\*.vb "..\..\..\AVP Lib\XMLResource\"
XCOPY /E /I /Y ..\Debug\ConfigFiles\SystemConfig\private\*.vb "..\..\..\AVP Lib\XMLResource\"
XCOPY /E /I /Y ..\Debug\ZedGraph.dll "..\Release\"
del ..\Debug\ConfigFiles\UserConfig\*.vb
del ..\Debug\ConfigFiles\SystemConfig\public\*.vb
del ..\Debug\ConfigFiles\SystemConfig\private\*.vb
cd .</PreBuildEvent>
  </PropertyGroup>
</Project>