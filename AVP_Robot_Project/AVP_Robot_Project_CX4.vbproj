  <Import Project="$(MSBuildBinPath)\Microsoft.VisualBasic.targets" />
  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
  <PropertyGroup>
    <PostBuildEvent>rd /S /Q CX4_Build_
mkdir CX4_Build_
copy AVP.exe CX4_Build_\
copy AVPLib.dll CX4_Build_\
copy NetLib.dll CX4_Build_\
copy AVPControls.dll CX4_Build_\
copy CustomTabControl.dll CX4_Build_\
copy Interop.OPCAutomation.dll CX4_Build_\
copy Interop.EMSERVICELib.dll CX4_Build_\
copy Interop.VALUELib.dll CX4_Build_\
copy AVPSecsGemLib.dll CX4_Build_\
copy RSTiApdater.dll CX4_Build_\
copy HRecipeLibrary.dll CX4_Build_\
XCOPY /E /I /Y ..\Debug\ConfigFiles CX4_Build_\ConfigFiles
XCOPY /E /I /Y ..\Debug\DataFiles CX4_Build_\DataFiles
copy log4net.dll CX4_Build_\
copy ..\Debug\Tail.exe CX4_Build_\
copy ..\Debug\AVP.exe.config CX4_Build_\
copy ..\..\..\..\ConfigurationManager\ConfigurationManager\bin\Debug\ConfigurationManager.exe.config CX4_Build_\
copy ..\..\..\..\ConfigurationManager\ConfigurationManager\bin\Release\ConfigurationManager.exe CX4_Build_\
copy ..\..\..\..\ConfigurationManager\ConfigurationManager\bin\Debug\ConfigurationManager.log4net CX4_Build_\
copy ZedGraph.dll CX4_Build_\
copy ..\Debug\"AVP CX4 GEM Manual.doc" CX4_Build_\
COPY ..\..\..\IdentifyCreator\IdentifyCreator\bin\Release\IdentifyCreator.exe CX4_Build_\
COPY ..\..\..\DeviceNetApp\DeviceNetApp\bin\Release\DeviceNetApp.exe CX4_Build_\
COPY ..\..\..\DeviceNetApp\DeviceNetApp\bin\Debug\DeviceNetApp.exe.config CX4_Build_\

SET ERRORLEVEL=0
C:\ScriptBuild\SendEmail_WhenBuild.exe CX4 CX4_Build_</PostBuildEvent>
    <PreBuildEvent>del ..\Debug\ConfigFiles\SystemConfig\private\MessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\Generic_MessageName.txt &gt;&gt;..\Debug\ConfigFiles\SystemConfig\private\MessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\PVD4_MessageName.txt &gt;&gt; ..\Debug\ConfigFiles\SystemConfig\private\MessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\PVD5T_MessageName.txt &gt;&gt; ..\Debug\ConfigFiles\SystemConfig\private\MessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\IBE_MessageName.txt &gt;&gt; ..\Debug\ConfigFiles\SystemConfig\private\MessageName.xml
del ..\Debug\ConfigFiles\SystemConfig\private\ParseMessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\Generic_ParseMessageName.txt&gt;&gt;..\Debug\ConfigFiles\SystemConfig\private\ParseMessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\PVD4_ParseMessageName.txt &gt;&gt; ..\Debug\ConfigFiles\SystemConfig\private\ParseMessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\PVD5T_ParseMessageName.txt &gt;&gt; ..\Debug\ConfigFiles\SystemConfig\private\ParseMessageName.xml
TYPE ..\Debug\ConfigFiles\SystemConfig\private\IBE_ParseMessageName.txt &gt;&gt; ..\Debug\ConfigFiles\SystemConfig\private\ParseMessageName.xml
..\Debug\ConvertXML2VB.exe ..\Debug\ConfigFiles\UserConfig\ ..\Debug\ConfigFiles\UserConfig\
..\Debug\ConvertXML2VB.exe ..\Debug\ConfigFiles\SystemConfig\private\ ..\Debug\ConfigFiles\SystemConfig\private\
..\Debug\ConvertXML2VB.exe ..\Debug\ConfigFiles\SystemConfig\public\ ..\Debug\ConfigFiles\SystemConfig\public\
XCOPY /E /I /Y ..\Debug\ConfigFiles\UserConfig\*.vb "..\..\..\AVP Lib\XMLResource\"
XCOPY /E /I /Y ..\Debug\ConfigFiles\SystemConfig\public\*.vb "..\..\..\AVP Lib\XMLResource\"
XCOPY /E /I /Y ..\Debug\ConfigFiles\SystemConfig\private\*.vb "..\..\..\AVP Lib\XMLResource\"
XCOPY /E /I /Y ..\Debug\ZedGraph.dll "..\Release\"
del ..\Debug\ConfigFiles\UserConfig\*.vb
del ..\Debug\ConfigFiles\SystemConfig\public\*.vb
del ..\Debug\ConfigFiles\SystemConfig\private\*.vb
cd .</PreBuildEvent>
  </PropertyGroup>
</Project>