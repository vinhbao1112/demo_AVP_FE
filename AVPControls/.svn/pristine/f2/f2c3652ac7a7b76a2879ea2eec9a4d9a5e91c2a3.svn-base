    ''' <author>Hai Tran</author>
    ''' <date>2019-11-21</date>
    ''' <summary>
    ''' Update wafer position.
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub UpdateWaferPostion()
        Try
            Dim location As Point = GetWaferMaskLocation()
            If location <> WaferMask.Location Then
                WaferMask.Location = location

                WaferMask.Invalidate()
                Me.Invalidate()
            End If
        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try
    End Sub

    ''' <author>Hai Tran</author>
    ''' <date>2020-07-01</date>
    ''' <summary>
    ''' Get wafer position.
    ''' </summary>
    ''' <remarks></remarks>
    Private Function GetWaferMaskLocation() As Point
        Try
            If LidStatus = DisplayStatus.Off Then
                m_waferMaskLocation = New Point(CHUCK_LEFT_POSITION, m_chuckHeightPosition)
            ElseIf LidStatus = DisplayStatus.On Then
                'If ChuckUpStatus = DisplayStatus.On Then
                '    m_waferMaskLocation = New Point(WAFER_POSITION_ON_OPEN_X, WAFER_POSITION_ON_OPEN_Y)
                'Else
                '    m_waferMaskLocation = New Point(39, 127)
                'End If
                m_waferMaskLocation = New Point(WAFER_POSITION_ON_OPEN_X, m_chuckHeightPositionWaferOnOpen)
            Else
                If ChuckUpStatus = DisplayStatus.On Then
                    m_waferMaskLocation = New Point(287, 95)
                Else
                    m_waferMaskLocation = New Point(291, 103)
                End If
            End If
        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try
        Return m_waferMaskLocation
    End Function

    ''' <author>Hai Tran</author>
    ''' <date>2020-07-01</date>
    ''' <summary>
    ''' Update wafer mask image.
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub UpdateWaferMaskImage()
        Try
            Dim oldImage As Bitmap = WaferMask.MaskImage

            If LidStatus = DisplayStatus.Off Then
                WaferMask.MaskImage = My.Resources.Resources.PVDA_SA_Wafer_Pattern
            ElseIf LidStatus = DisplayStatus.On Then
                WaferMask.MaskImage = My.Resources.Resources.PVDA_SA_Wafer_Pattern
            Else
                WaferMask.MaskImage = My.Resources.Resources.PVDA_SA_LidUnknown_Wafer_Pattern
            End If

            If oldImage IsNot Nothing Then
                oldImage.Dispose()
            End If
        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try
    End Sub

    ''' <author>Hai Tran</author>
    ''' <date>2019-11-22</date>
    ''' <summary>
    ''' Update wafer location
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
