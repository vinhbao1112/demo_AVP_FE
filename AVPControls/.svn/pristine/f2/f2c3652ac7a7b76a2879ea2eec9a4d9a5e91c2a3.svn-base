Imports System.ComponentModel
Imports AVPControls.AVPDataLib

Public Class PVDAStandaloneChamberControl

#Region "Fields"

    Const SHUTTER_OFF_LEFT_POSITION As Integer = 278
    Const SHUTTER_ON_LEFT_POSITION As Integer = 455
    Const CHUCK_LEFT_POSITION As Integer = 288
    Const CHUCK_UP_POSITION As Integer = 161
    Const CHUCK_DOWN_POSITION As Integer = 185
    Const WAFER_POSITION_ON_OPEN_X As Integer = 39
    Const WAFER_POSITION_ON_OPEN_Y As Integer = 115
    Const WAFER_POSITION_ON_OPEN_CHUCK_DOWN_Y As Integer = 135
    Const SHUTTER_OFF_TOP_POSITION As Integer = 250
    Const SHUTTER_ON_TOP_POSITION As Integer = 249
    Const SHUTTER_UNK_TOP_POSITION As Integer = 250

    Private _targetText As String = "Target"
    Private _currentTargetKwh As String = ""
    Private _targetMaterialText As String = ""
    Private _lidClosed As Boolean = True
    Private _waferEnabled As Boolean = True
    Private _shutterEnabled As Boolean = True
    Private m_chuckText As String = ""
    Private m_chuckPositionText As String = String.Empty
    Private m_chuckHeightPosition As Integer = CHUCK_UP_POSITION
    Private m_chuckHeightPositionWaferOnOpen As Integer = WAFER_POSITION_ON_OPEN_CHUCK_DOWN_Y
    Private m_chuckUpStatus As DisplayStatus = DisplayStatus.On
    Private m_lidStatus As DisplayStatus = DisplayStatus.Off
    Private m_waferMaskLocation As Point
    Private _groundEnabled As Boolean = True
    Private _numberOfSlots As Integer = 5
    Private _movingVisible As Boolean = True
    Private _movingStatus As DisplayStatus = DisplayStatus.Off
#End Region

