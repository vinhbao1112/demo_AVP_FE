    ''' <author>Hai Tran</author>
    ''' <date>2019-11-07</date>
    ''' <summary>
    ''' Gets or sets a value indicating whether the Lid is closed.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(True)> _
    Public Property LidClosed() As Boolean
        Get
            Return _lidClosed
        End Get
        Set(ByVal value As Boolean)
            If _lidClosed <> value Then
                _lidClosed = value

                If value Then
                    LidStatus = DisplayStatus.Off
                Else
                    LidStatus = DisplayStatus.On
                End If
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2020-07-01</date>
    ''' <summary>
    ''' Gets or sets lid status.
    ''' Off: Lid Closed,
    ''' On: Lid Opened,
    ''' Other: Lid Unknown
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(DisplayStatus), "Off")> _
    Public Property LidStatus() As DisplayStatus
        Get
            Return m_lidStatus
        End Get
        Set(ByVal value As DisplayStatus)
            If m_lidStatus <> value Then
                m_lidStatus = value
                _lidClosed = (m_lidStatus = DisplayStatus.Off)

                If m_lidStatus = DisplayStatus.Off OrElse m_lidStatus = DisplayStatus.On Then
                    WaferMask.Cursor = Cursors.Hand
                End If

                UpdateWaferMaskImage()
                UpdateView()
                UpdateWaferPostion()

                RaiseDoorStatusChangedEvent()
            End If
        End Set
    End Property

