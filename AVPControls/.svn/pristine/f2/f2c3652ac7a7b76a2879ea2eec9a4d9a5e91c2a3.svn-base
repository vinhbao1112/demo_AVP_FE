    ''' <remarks></remarks>
    <DefaultValue("CurrentTargetKwh")> _
    Public Property CurrentTargetKwh() As String
        Get
            Return _currentTargetKwh
        End Get
        Set(ByVal value As String)
            If _currentTargetKwh <> value Then
                _currentTargetKwh = value
                UpdateView()
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2019-11-07</date>
    ''' <summary>
    ''' Gets or sets the text on target.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
