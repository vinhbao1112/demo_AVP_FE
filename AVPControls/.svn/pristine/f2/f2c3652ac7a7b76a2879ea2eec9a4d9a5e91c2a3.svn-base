#Region "Constructors"

    Public Sub New()

        ' This call is required by the Windows Form Designer.
        InitializeComponent()

        ' Add any initialization after the InitializeComponent() call.
        AddHandler Me.ShutterStatusChanged, AddressOf Shutter_StatusChanged
        AddHandler Me.ShutterInstalledChanged, AddressOf Shutter_InstalledChanged
        AddHandler Me.GroundStatusChanged, AddressOf Ground_StatuseChanged
        UpdateWaferPostion()
        Me.EnableFormLevelDoubleBuffering = True

    End Sub

#End Region

#Region "Methods"

    ''' <author>Hai Tran</author>
    ''' <date>2019-11-07</date>
    ''' <summary>
    ''' Generate PVDA Standalone image.
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Protected Overrides Function GenerateControlImage() As System.Drawing.Bitmap
        Dim chamberImage As Bitmap = Nothing
        If TargetPlasmaOn Then
            chamberImage = My.Resources.PVDA_SA_Chamber_TargetPlasma
        Else
            chamberImage = My.Resources.PVDA_SA_Chamber
        End If
        Try
            Using g As Graphics = Graphics.FromImage(chamberImage)
                Dim waferImage As Bitmap
                If Me.NumberOfSlots = 4 Then
                    Select Case Me.WaferStatus
                        Case AVPDataLib.WaferStatuses.UNPROCESS
                            waferImage = My.Resources.Resources.PVDA_SA_WaferUnprocess_4Wafer
                        Case AVPDataLib.WaferStatuses.PARTIAL
                            waferImage = My.Resources.Resources.PVDA_SA_WaferPartial_4Wafer
                        Case AVPDataLib.WaferStatuses.ERROR
                            waferImage = My.Resources.Resources.PVDA_SA_WaferError_4Wafer
                        Case AVPDataLib.WaferStatuses.COMPLETE
                            waferImage = My.Resources.Resources.PVDA_SA_WaferCompleted_4Wafer
                        Case Else
                            waferImage = My.Resources.Resources.PVDA_SA_WaferNone
                    End Select
                Else
                    Select Case Me.WaferStatus
                        Case AVPDataLib.WaferStatuses.UNPROCESS
                            waferImage = My.Resources.Resources.PVDA_SA_WaferUnprocess
                        Case AVPDataLib.WaferStatuses.PARTIAL
                            waferImage = My.Resources.Resources.PVDA_SA_WaferPartial
                        Case AVPDataLib.WaferStatuses.ERROR
                            waferImage = My.Resources.Resources.PVDA_SA_WaferError
                        Case AVPDataLib.WaferStatuses.COMPLETE
                            waferImage = My.Resources.Resources.PVDA_SA_WaferCompleted
                        Case Else
                            waferImage = My.Resources.Resources.PVDA_SA_WaferNone
                    End Select
                End If

                'Draw chuck on door closed
                If LidStatus = DisplayStatus.Off Then
                    g.DrawImage(waferImage, CHUCK_LEFT_POSITION, m_chuckHeightPosition)
                    waferImage.Dispose()

                    Dim chuckImage As Bitmap
                    If BiasPlasmaOn Then
                        chuckImage = My.Resources.Resources.PVD24XX_ChuckPlasma
                    Else
                        chuckImage = My.Resources.Resources.PVD24XX_Chuck
                    End If

                    g.DrawImageUnscaled(chuckImage, CHUCK_LEFT_POSITION, m_chuckHeightPosition)
                    chuckImage.Dispose()
                ElseIf LidStatus = DisplayStatus.On Then
                    ' When lid is opened, draw lid (bias) first.
                Else
                    Dim chuckImage As Bitmap = My.Resources.Resources.PVDA_SA_LidUnknown_Chuck

                    If ChuckUpStatus = DisplayStatus.Off Then
                        g.DrawImageUnscaled(chuckImage, 291, 103)
                    Else
                        g.DrawImageUnscaled(chuckImage, 287, 95)
                    End If

                    chuckImage.Dispose()
                End If

                ' Draw bias.
                Dim biasImage As Bitmap = GenerateBiasImage()

                g.DrawImageUnscaled(biasImage, 0, 0)
                biasImage.Dispose()

                ' Draw chuck on door open
                If LidStatus = DisplayStatus.On Then
                    If ChuckUpStatus = DisplayStatus.Off Then
                        Dim chuckImage As Bitmap = My.Resources.Resources.PVDA_SA_LidOpen_ChuckDown

                        g.DrawImageUnscaled(chuckImage, 0, 0)
                        chuckImage.Dispose()
                    End If

                    g.DrawImage(waferImage, WAFER_POSITION_ON_OPEN_X, m_chuckHeightPositionWaferOnOpen)
                    waferImage.Dispose()
                End If

                ' Draw target text.
                If Not String.IsNullOrEmpty(TargetText) Then
                    Dim f As New Font("Times New Roman", 11, FontStyle.Bold, GraphicsUnit.Point)
                    Dim strFormat As New StringFormat()
                    strFormat.Alignment = StringAlignment.Center
                    strFormat.LineAlignment = StringAlignment.Center

                    g.DrawString(TargetText, f, Brushes.Black, New RectangleF(306, 337, 128, 25), strFormat)
                    g.DrawString(TargetMaterialText, f, Brushes.Black, New RectangleF(306, 317, 128, 25), strFormat)
                    g.DrawString(CurrentTargetKwh, f, Brushes.Black, New RectangleF(306, 297, 128, 25), strFormat)

                    f.Dispose()
                End If

            End Using
        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try
        Return chamberImage
    End Function

    ''' <author>Hai Tran</author>
    ''' <date>2019-11-20</date>
    ''' <summary>
    ''' Generate control image.
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Protected Overridable Function GenerateBiasImage() As System.Drawing.Bitmap
        Dim img As Bitmap
        If LidStatus = DisplayStatus.Off Then
            img = My.Resources.Resources.PVDA_SA_LidClosed
        ElseIf LidStatus = DisplayStatus.On Then
            img = My.Resources.Resources.PVDA_SA_LidOpen
        Else
            img = My.Resources.Resources.PVDA_SA_LidUnknown
        End If

        Try
            Using g As Graphics = Graphics.FromImage(img)

                ' Draw chuck text.
                If Not String.IsNullOrEmpty(ChuckText) Then
                    Dim f As New Font("Times New Roman", 11, FontStyle.Bold, GraphicsUnit.Point)
                    Dim strFormat As New StringFormat()
                    strFormat.Alignment = StringAlignment.Center
                    strFormat.LineAlignment = StringAlignment.Center

                    Dim drawRect As RectangleF
                    If LidStatus = DisplayStatus.Off Then
                        drawRect = New RectangleF(316, 126, 136, 23)
                        g.DrawString(ChuckText, f, Brushes.Black, drawRect, strFormat)
                    ElseIf LidStatus = DisplayStatus.On Then
                        drawRect = New RectangleF(62, 250, 136, 23)
                        g.DrawString(ChuckText, f, Brushes.Black, drawRect, strFormat)
                    Else
                        drawRect = New RectangleF(319, 83, 136, 23)

                        Dim gstate As Drawing2D.GraphicsState = g.Save()

                        'g.SetClip(drawRect, Drawing2D.CombineMode.Replace)
                        g.TranslateTransform(309, 83)
                        g.RotateTransform(-31)
                        g.DrawString(ChuckText, f, Brushes.Black, 0, 0)

                        g.Restore(gstate)
                    End If

                    f.Dispose()
                End If

                ' Draw chuck position text.
                If Not String.IsNullOrEmpty(ChuckPositionText) Then
                    Dim f As New Font("Times New Roman", 11, FontStyle.Bold, GraphicsUnit.Point)
                    Dim strFormat As New StringFormat()
                    strFormat.Alignment = StringAlignment.Center
                    strFormat.LineAlignment = StringAlignment.Center

                    Dim drawRect As RectangleF
                    If LidStatus = DisplayStatus.Off Then
                        drawRect = New RectangleF(316, 91, 145, 26)
                    ElseIf LidStatus = DisplayStatus.On Then
                        drawRect = New RectangleF(54, 295, 145, 26)
                    Else
                        drawRect = New RectangleF(54, 295, 145, 26)
                    End If

                    g.DrawString(ChuckPositionText, f, Brushes.Black, drawRect, strFormat)

                    f.Dispose()
                End If

            End Using

        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try

        Return img
    End Function

    ''' <author>Hai Tran</author>
    ''' <date>2019-11-07</date>
    ''' <summary>
    ''' Handles and forward status change to child control.
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Private Sub Shutter_StatusChanged(ByVal sender As Object, ByVal e As EventArgs)
        Me.ShutterControl.Status = Me.ShutterStatus
        Try
            If Me.ShutterStatus = AVPDataLib.DisplayStatus.On Then
                Me.ShutterControl.Left = SHUTTER_ON_LEFT_POSITION
                Me.ShutterControl.Top = SHUTTER_ON_TOP_POSITION
            ElseIf Me.ShutterStatus = AVPDataLib.DisplayStatus.Off Then
                Me.ShutterControl.Left = SHUTTER_OFF_LEFT_POSITION
                Me.ShutterControl.Top = SHUTTER_OFF_TOP_POSITION
            Else
                Me.ShutterControl.Left = CInt((SHUTTER_ON_LEFT_POSITION + SHUTTER_OFF_LEFT_POSITION) / 2)
                Me.ShutterControl.Top = SHUTTER_UNK_TOP_POSITION
            End If
        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try
    End Sub

