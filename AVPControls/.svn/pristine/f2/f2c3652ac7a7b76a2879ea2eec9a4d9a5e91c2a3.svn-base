    ''' <date>2020-08-05</date>
    ''' <summary>
    ''' Gets or sets number of slots.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(5)> _
    Public Property NumberOfSlots() As Integer
        Get
            Return _numberOfSlots
        End Get
        Set(ByVal value As Integer)
            If _numberOfSlots <> value AndAlso value > 0 Then
                _numberOfSlots = value

                UpdateView()
            End If
        End Set
    End Property

