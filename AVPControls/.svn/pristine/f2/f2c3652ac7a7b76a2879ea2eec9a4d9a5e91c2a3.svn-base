    ''' <author>Hai Tran</author>
    ''' <date>2019-11-21</date>
    ''' <summary>
    ''' Gets or sets a value indicating whether the chuck is up.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(DisplayStatus), "On")> _
    Public Property ChuckUpStatus() As DisplayStatus
        Get
            Return m_chuckUpStatus
        End Get
        Set(ByVal value As DisplayStatus)
            If m_chuckUpStatus <> value Then
                m_chuckUpStatus = value

                If m_chuckUpStatus = DisplayStatus.On OrElse m_chuckUpStatus = DisplayStatus.Off Then
                    If m_chuckUpStatus = DisplayStatus.On Then
                        m_chuckHeightPosition = CHUCK_UP_POSITION
                        m_chuckHeightPositionWaferOnOpen = WAFER_POSITION_ON_OPEN_CHUCK_DOWN_Y
                    ElseIf m_chuckUpStatus = DisplayStatus.Off Then
                        m_chuckHeightPosition = CHUCK_DOWN_POSITION
                        m_chuckHeightPositionWaferOnOpen = WAFER_POSITION_ON_OPEN_Y
                    End If

                    UpdateView()
                    UpdateWaferPostion()
                End If

                RaiseChuckStatusChangedEvent()
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2019-11-21</date>
    ''' <summary>
    ''' Gets chuck height position.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)> _
    Public ReadOnly Property ChuckHeightPosition() As Integer
        Get
            Return m_chuckHeightPosition
        End Get
    End Property

