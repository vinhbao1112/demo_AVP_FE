        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets text error status.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(""), Category(Category)> _
    Public Property ErrorText() As String
        Get
            Return _errorText
        End Get
        Set(ByVal value As String)
            If _errorText <> value Then
                _errorText = value
                If Status = AVPDataLib.DisplayStatus.Error Then
                    UpdateView()
                End If
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets image off status.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Bitmap), "Nothing"), Category(Category)> _
    Public Property OffImage() As Bitmap
        Get
            Return _offImage
        End Get
        Set(ByVal value As Bitmap)
            _offImage = value
            If Status = AVPDataLib.DisplayStatus.Off Then
                UpdateView()
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets image on status.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Bitmap), "Nothing"), Category(Category)> _
    Public Property OnImage() As Bitmap
        Get
            Return _onImage
        End Get
        Set(ByVal value As Bitmap)
            _onImage = value
            If Status = AVPDataLib.DisplayStatus.On Then
                UpdateView()
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets image unknown status.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Bitmap), "Nothing"), Category(Category)> _
    Public Property UnknownImage() As Bitmap
        Get
            Return _unkImage
        End Get
        Set(ByVal value As Bitmap)
            _unkImage = value
            If Status = AVPDataLib.DisplayStatus.Unknow Then
                UpdateView()
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets image unknown status.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Bitmap), "Nothing"), Category(Category)> _
    Public Property ErrorImage() As Bitmap
        Get
            Return _errorImage
        End Get
        Set(ByVal value As Bitmap)
            _errorImage = value
            If Status = AVPDataLib.DisplayStatus.Error Then
                UpdateView()
