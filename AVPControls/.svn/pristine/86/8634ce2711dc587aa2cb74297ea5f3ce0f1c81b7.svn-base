    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Color), "White"), Category(Category)> _
    Public Property OnTextColor() As Color
        Get
            Return _onTextColor
        End Get
        Set(ByVal value As Color)
            If _onTextColor <> value Then
                _onTextColor = value
                If Status = AVPDataLib.DisplayStatus.On Then
                    UpdateView()
                End If
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets unknown statis text color.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Color), "Black"), Category(Category)> _
    Public Property UnknownTextColor() As Color
        Get
            Return _unkTextColor
        End Get
        Set(ByVal value As Color)
            If _unkTextColor <> value Then
                _unkTextColor = value
                If Status = AVPDataLib.DisplayStatus.Unknow Then
                    UpdateView()
                End If
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets error statis text color.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Color), "White"), Category(Category)> _
    Public Property ErrorTextColor() As Color
        Get
            Return _errorTextColor
        End Get
        Set(ByVal value As Color)
            If _errorTextColor <> value Then
                _errorTextColor = value
                If Status = AVPDataLib.DisplayStatus.Error Then
                    UpdateView()
                End If
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets location for drawing text if location is not auto.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Point), "0, 0"), Category(Category)> _
    Public Property TextLocation() As Point
        Get
            Return _textLocation
        End Get
        Set(ByVal value As Point)
            If _textLocation <> value Then
                _textLocation = value
                If Not _autoTextLocation Then
                    UpdateView()
                End If
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets a value indicating whether the text is drawn in center of image.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(True), Category(Category)> _
    Public Property AutoTextLocation() As Boolean
        Get
            Return _autoTextLocation
        End Get
        Set(ByVal value As Boolean)
            If _autoTextLocation <> value Then
                _autoTextLocation = value
                UpdateView()
            End If
        End Set
    End Property

#End Region

#Region "Methods"

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Generate image.
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Protected Overrides Function GenerateControlImage() As System.Drawing.Bitmap
        Try
            Dim img As Bitmap = Nothing
            Dim t As String = Text
            Dim c As Color = ForeColor
            Select Case Status
                Case AVPDataLib.DisplayStatus.Off
                    img = OffImage
                    t = OffText
                    c = OffTextColor
                Case AVPDataLib.DisplayStatus.On
                    img = OnImage
                    t = OnText
                    c = OnTextColor
                Case AVPDataLib.DisplayStatus.Unknow
                    img = UnknownImage
                    t = UnknownText
                    c = UnknownTextColor
                Case AVPDataLib.DisplayStatus.Error
                    img = ErrorImage
                    t = ErrorText
                    c = ErrorTextColor
            End Select

            If img IsNot Nothing Then
                ' Copy of current bitmap.
                img = New Bitmap(img)

                ' Draw text.
                If Not String.IsNullOrEmpty(t) Then
                    Using g As Graphics = Graphics.FromImage(img), brush As New SolidBrush(c)
                        If AutoTextLocation Then
                            Dim sizet As SizeF = g.MeasureString(t, Font)
                            Dim x As Integer = CInt((img.Width - sizet.Width) / 2.0F)
                            Dim y As Integer = CInt((img.Height - sizet.Height) / 2.0F)

                            g.DrawString(t, Font, brush, x, y)
                        Else
                            g.DrawString(t, Font, brush, _textLocation)
                        End If
                    End Using
                End If
            End If

            Return img
        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try
        Return Nothing
    End Function
#End Region


End Class
