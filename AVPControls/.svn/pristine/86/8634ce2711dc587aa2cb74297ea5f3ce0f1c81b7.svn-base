Imports System.ComponentModel

Public Class ImageStatusControl

#Region "Fields"
    Private Const Category As String = "Status Options"

    Private _offText As String
    Private _onText As String
    Private _unkText As String
    Private _errorText As String

    Private _offImage As Bitmap
    Private _onImage As Bitmap
    Private _unkImage As Bitmap
    Private _errorImage As Bitmap

    Private _offTextColor As Color = Color.White
    Private _onTextColor As Color = Color.White
    Private _unkTextColor As Color = Color.Black
    Private _errorTextColor As Color = Color.White

    Private _textLocation As Point
    Private _autoTextLocation As Boolean = True

#End Region

#Region "Properties"

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets text off status.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(""), Category(Category)> _
    Public Property OffText() As String
        Get
            Return _offText
        End Get
        Set(ByVal value As String)
            If _offText <> value Then
                _offText = value
                If Status = AVPDataLib.DisplayStatus.Off Then
                    UpdateView()
                End If
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets text on status.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(""), Category(Category)> _
    Public Property OnText() As String
        Get
            Return _onText
        End Get
        Set(ByVal value As String)
            If _onText <> value Then
                _onText = value
                If Status = AVPDataLib.DisplayStatus.On Then
                    UpdateView()
                End If
            End If
        End Set
    End Property

    ''' <author>Hai Tran</author>
    ''' <date>2016-06-24</date>
    ''' <summary>
    ''' Gets or sets text unknown status.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(""), Category(Category)> _
    Public Property UnknownText() As String
