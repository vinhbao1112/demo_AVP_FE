Public Class AVPKeyboard

    Public Sub New()

        ' This call is required by the Windows Form Designer.
        InitializeComponent()

        ' Add any initialization after the InitializeComponent() call.
        Me.UseFittedTitle = False
        Me.DragOverEdge = False

    End Sub

    Private Sub AVPKeyboard_SizeChanged(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles MyBase.SizeChanged
        Me.txtDisplay.Width = Me.pnlTop.Width - 6
    End Sub
End Class