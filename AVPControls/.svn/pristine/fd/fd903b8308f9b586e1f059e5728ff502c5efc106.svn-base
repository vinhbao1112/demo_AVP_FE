    ''' <summary>
    ''' Gets/Sets Arm Status
    ''' </summary>
    ''' <remarks></remarks>
    <DefaultValue(GetType(ArmStatuses), "Retract")> _
    Public Property ArmStatus() As ArmStatuses
        Get
