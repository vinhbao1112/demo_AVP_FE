Imports System.ComponentModel
Imports AVPControls
Imports AVPControls.AVPDataLib

Public Class PVD2R4ChamberControl

#Region "Fields"
    Private Const TARGET_WIDTH As Integer = 335
    Private Const TARGET_HEIGHT As Integer = 25
    Private Const MIN_CHUCK_HEIGHT As Single = 0.0F
    Private Const MAX_CHUCK_HEIGHT As Single = 35.0F
    Private Const CHUCK_Y_AXIS As Integer = 121
    Private Const CHUCK_X_AXIS As Integer = 115
    Private Const DOOR_SHIELD As String = "DoorShield"
    Private Const SHUTTER_UP_POSITION As Integer = 42
    Private Const SHUTTER_DOWN_POSITION As Integer = 62
    Private Const SHUTTER_UNKNOWN_POSITION As Integer = 52

    Private m_chuckHeight As Single
    Private m_chuckPosition As Single
    Private m_targetTexts(3) As String
    Private m_waferLocation As Point
    Private m_shutterPosition(3) As AVPDirections

    ''' <summary>
    ''' Occurs when DoorShield is clicked.
    ''' </summary>
    ''' <remarks></remarks>
    Public Event DoorShieldClick As EventHandler

    ''' <summary>
    ''' Occurs when WaferControl is clicked.
    ''' </summary>
    ''' <remarks></remarks>
    Public Event WaferControlClick As EventHandler

#End Region

