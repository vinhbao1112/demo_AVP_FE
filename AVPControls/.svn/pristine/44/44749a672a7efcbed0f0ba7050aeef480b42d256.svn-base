    ''' <summary>
    ''' Gets or sets a value indicates status of door shield.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(DisplayStatus), "Off")> _
    Public Property DoorShieldStatus() As DisplayStatus
        Get
            Return DoorShield.Status
        End Get
        Set(ByVal value As DisplayStatus)
            DoorShield.Status = value
        End Set
    End Property

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2015-12-18</date>
    ''' </author>
    ''' <summary>
    ''' Gets or sets a value indicates chuck position of chamber.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    <DefaultValue(GetType(Single), "0")> _
    Public Property ChuckPosition() As Single
        Get
            Return m_chuckPosition
        End Get
        Set(ByVal value As Single)
            If m_chuckPosition = value Then
                Return
            End If

            m_chuckPosition = value

            Dim height As Single = m_chuckHeight
            If m_chuckPosition < MIN_CHUCK_HEIGHT Then
                height = MIN_CHUCK_HEIGHT
            ElseIf m_chuckPosition > MAX_CHUCK_HEIGHT Then
                height = MAX_CHUCK_HEIGHT
            Else
                height = m_chuckPosition
            End If

            If m_chuckHeight <> height Then
                m_chuckHeight = height
                SetWaferLocation()
                UpdateView()
            End If
        End Set
    End Property

