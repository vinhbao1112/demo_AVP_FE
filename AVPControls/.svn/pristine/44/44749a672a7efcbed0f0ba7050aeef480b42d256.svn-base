#Region "Methods"
    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2015-12-18</date>
    ''' </author>
    ''' <summary>
    ''' Generates PVD2R4 chamber image.
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Protected Overrides Function GenerateControlImage() As System.Drawing.Bitmap
        Try
            Dim imgChamber As Bitmap = My.Resources.Resources.PVD2R4_Chamber
            Using g As Graphics = Graphics.FromImage(imgChamber)
                ' Draw slit valve.
                Dim imgSlitValve As Bitmap
                Select Case m_slitValveStatus
                    Case DisplayStatus.Off
                        imgSlitValve = My.Resources.Resources.PVD2R4_SlitValve_Close
                    Case DisplayStatus.On
                        imgSlitValve = My.Resources.Resources.PVD2R4_SlitValve_Open
                    Case Else
                        imgSlitValve = My.Resources.Resources.PVD2R4_SlitValve_Unknown
                End Select
                g.DrawImageUnscaled(imgSlitValve, 0, 114)
                imgSlitValve.Dispose()

                ' Draw targets.
                Dim imgTarget As Bitmap = GenerateTargetImage()
                g.DrawImageUnscaled(imgTarget, 42, 15)
                imgTarget.Dispose()

                ' Draw chuck.
                If m_chuckInstalled Then
                    Dim imgChuck As Bitmap
                    If m_biasPlasmaOn Then
                        imgChuck = My.Resources.Resources.PVD2R4_Chuck_Plasma
                    Else
                        imgChuck = My.Resources.Resources.PVD2R4_Chuck
                    End If

                    Dim yChuck As Integer = CInt(CHUCK_Y_AXIS - m_chuckHeight)
                    g.DrawImageUnscaled(imgChuck, CHUCK_X_AXIS, yChuck)
                    imgChuck.Dispose()

                End If

                g.Dispose()
            End Using

            Return imgChamber
        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try
        Return Nothing
    End Function

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2015-12-18</date>
    ''' </author>
    ''' <summary>
    ''' Generates Target image of PVD2R4 chamber.
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Private Function GenerateTargetImage() As Bitmap
        Try
            ' Get images from resources.
            Dim imgTarget As Bitmap = My.Resources.Resources.PVD2R4_Target
            Dim imgTargetPlasma As Bitmap = My.Resources.Resources.PVD2R4_Target_Plasma
            Dim imgShutterUnk As Bitmap = My.Resources.Resources.PVD2R4_Shutter_Unknown
            Dim imgShutterOpen As Bitmap = My.Resources.Resources.PVD2R4_Shutter_Open
            Dim imgShutterClose As Bitmap = My.Resources.Resources.PVD2R4_Shutter_Close

            ' Store size of image for fast access.
            Dim imgTargetWidth As Integer = imgTarget.Width
            Dim imgTargetHeight As Integer = imgTarget.Height

            ' Create image for drawing targets and shutters.
            Dim imgTargetShutter As New Bitmap(TARGET_WIDTH, TARGET_HEIGHT)
            imgTargetShutter.SetResolution(imgTarget.HorizontalResolution, imgTarget.VerticalResolution)

            ' Drawing.
            Using g As Graphics = Graphics.FromImage(imgTargetShutter)
                Dim textFont As New Font("Times New Roman", 10, FontStyle.Bold, GraphicsUnit.Point)
                Dim textColor As Color
                For index As Integer = 0 To m_targetInstalled.Length - 1
                    If m_targetInstalled(index) Then
                        Dim x As Integer = index * (imgTargetWidth + 1)

                        ' Draw target.
                        If m_targetPlasmaOn(index) Then
                            g.DrawImageUnscaled(imgTargetPlasma, x, 0)
                            textColor = Color.White
                        Else
                            g.DrawImageUnscaled(imgTarget, x, 0)
                            textColor = Color.Black
                        End If

                        ' Draw target text.
                        Dim targetText As String = "T" & (index + 1).ToString()
                        If Not String.IsNullOrEmpty(m_targetTexts(index)) Then
                            targetText &= "-" & m_targetTexts(index)
                        End If

                        Dim sizeText As SizeF = g.MeasureString(targetText, textFont)
                        Dim brushText As New SolidBrush(textColor)
                        g.DrawString(targetText, textFont, brushText, x + (imgTargetWidth - sizeText.Width) / 2.0F, (imgTargetHeight - sizeText.Height) / 2.0F - 2)
                        brushText.Dispose()

                    End If
                Next

                textFont.Dispose()
                g.Dispose()
            End Using
            imgTarget.Dispose()
            imgTargetPlasma.Dispose()
            imgShutterUnk.Dispose()
            imgShutterOpen.Dispose()
            imgShutterClose.Dispose()

            Return imgTargetShutter
        Catch ex As Exception
            Logger.Error(ex.ToString)
        End Try
        Return Nothing
    End Function

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2016-01-05</date>
    ''' </author>
    ''' <summary>
    ''' Provides wafer location.
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetWaferLocation() As Point
        Return m_waferLocation
    End Function

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2016-01-05</date>
    ''' </author>
    ''' <summary>
    ''' Set wafer location.
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub SetWaferLocation()
        Dim x As Integer = 146
        Dim y As Integer = CInt(CHUCK_Y_AXIS - m_chuckHeight + 2)
        m_waferLocation = New Point(x, y)
        Me.WaferControl.Location = m_waferLocation
    End Sub

#End Region

#Region "Events"

    Public Sub New()

        ' This call is required by the Windows Form Designer.
        InitializeComponent()

        ' Add any initialization after the InitializeComponent() call.
        Me.RequireInitializeForUpdateView = False
        Me.UpdateViewOnWaferChanged = False
        Me.ChamberType = AVPChamberTypes.PVD2R4
        Me.UseCachingRegion = True
        Me.NumberOfTargets = 4
        Me.NumberOfShutters = 4
        For index As Integer = 0 To m_targetTexts.Length - 1
            m_targetTexts(index) = String.Empty
        Next
        Me.DoorShield.Location = New Point(41, 104)
        Me.DoorShield.ResumeUpdateView()
        Me.SetWaferLocation()
        For index As Integer = 0 To 3
            m_shutterPosition(index) = AVPDirections.Up
        Next

        Me.UpdateView()

    End Sub

