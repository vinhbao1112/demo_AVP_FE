    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2016-01-05</date>
    ''' </author>
    ''' <summary>
    ''' Update Shutter visibility.
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Private Sub PVD2R4ChamberControl_ShutterInstalledChanged(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.ShutterInstalledChanged
        Me.Shutter1.Visible = Me.Shutter1Installed
        Me.Shutter2.Visible = Me.Shutter2Installed
        Me.Shutter3.Visible = Me.Shutter3Installed
        Me.Shutter4.Visible = Me.Shutter4Installed
    End Sub

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2016-01-05</date>
    ''' </author>
    ''' <summary>
    ''' Update Shutter status.
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Private Sub PVD2R4ChamberControl_ShutterStatusChanged(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.ShutterStatusChanged
        Me.Shutter1.Status = Me.Shutter1Status
        Me.Shutter2.Status = Me.Shutter2Status
        Me.Shutter3.Status = Me.Shutter3Status
        Me.Shutter4.Status = Me.Shutter4Status
    End Sub

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2016-01-05</date>
    ''' </author>
    ''' <summary>
    ''' Update wafer ID to control.
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Private Sub PVD2R4ChamberControl_WaferIDChanged(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.WaferIDChanged
        Me.WaferControl.WaferID = Me.WaferID
    End Sub

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2016-01-05</date>
    ''' </author>
    ''' <summary>
    ''' Show/Hide wafer control base on status.
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Private Sub PVD2R4ChamberControl_WaferStatusChanged(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.WaferStatusChanged
        Me.WaferControl.WaferStatus = Me.WaferStatus
        If Me.WaferStatus = WaferStatuses.NONE Then
            Me.WaferControl.Visible = False
        Else
            Me.WaferControl.Visible = True
        End If
    End Sub

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2016-01-05</date>
    ''' </author>
    ''' <summary>
    ''' Update shutter position.
    ''' </summary>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Protected Overridable Sub OnShutterPositionChanged(ByVal e As EventArgs)
        Me.Shutter1.Top = CInt(IIf(m_shutterPosition(0) = AVPDirections.Down, SHUTTER_DOWN_POSITION, IIf(m_shutterPosition(0) = AVPDirections.Up, SHUTTER_UP_POSITION, SHUTTER_UNKNOWN_POSITION)))
        Me.Shutter2.Top = CInt(IIf(m_shutterPosition(1) = AVPDirections.Down, SHUTTER_DOWN_POSITION, IIf(m_shutterPosition(1) = AVPDirections.Up, SHUTTER_UP_POSITION, SHUTTER_UNKNOWN_POSITION)))
        Me.Shutter3.Top = CInt(IIf(m_shutterPosition(2) = AVPDirections.Down, SHUTTER_DOWN_POSITION, IIf(m_shutterPosition(2) = AVPDirections.Up, SHUTTER_UP_POSITION, SHUTTER_UNKNOWN_POSITION)))
        Me.Shutter4.Top = CInt(IIf(m_shutterPosition(3) = AVPDirections.Down, SHUTTER_DOWN_POSITION, IIf(m_shutterPosition(3) = AVPDirections.Up, SHUTTER_UP_POSITION, SHUTTER_UNKNOWN_POSITION)))
    End Sub

    ''' <author>
    '''     <name>Hai Tran</name>
    '''     <date>2016-01-22</date>
    ''' </author>
    ''' <summary>
    ''' Show or hide wafer control.
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Private Sub WaferControl_WaferStatusChanged(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles WaferControl.WaferStatusChanged
        Try
            If WaferControl.WaferStatus = WaferStatuses.NONE Then
                WaferControl.Visible = False
            Else
                WaferControl.Visible = True
            End If
        Catch ex As Exception
            Logger.Error(ex.ToString())
        End Try
    End Sub

#End Region


End Class
