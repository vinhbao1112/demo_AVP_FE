Imports System.ComponentModel
Imports AVPControls.AVPDataLib

Public Class RobotBodyControl

#Region "Fields"
    Private m_alignerAtStation As RobotArmStations = RobotArmStations.LLA
    Private m_sensorsInstalled As Boolean = True
    Private m_AlignerAt2Station As Boolean = False
    Private m_LLAInstalled As Boolean = True
    Private m_LLBInstalled As Boolean = True
    Private m_PM1Installed As Boolean = True
    Private m_PM2Installed As Boolean = True
    Private m_PM3Installed As Boolean = True
#End Region

#Region "Properties"

    <DefaultValue(GetType(Boolean), "False")> _
    Public Property AlignerAt2Station() As Boolean
        Get
            Return m_AlignerAt2Station
        End Get
        Set(ByVal value As Boolean)
            If m_AlignerAt2Station <> value Then
                m_AlignerAt2Station = value
                UpdateLLSensor()
                Me.UpdateView()
            End If
        End Set
    End Property

    <DefaultValue(GetType(RobotArmStations), "LLA")> _
    Public Property AlignerAtStation() As RobotArmStations
        Get
            Return m_alignerAtStation
        End Get
        Set(ByVal value As RobotArmStations)
            If m_alignerAtStation <> value Then
                m_alignerAtStation = value
                UpdateLLSensor()
                Me.UpdateView()
            End If
        End Set
    End Property

    <Browsable(False), DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)> _
